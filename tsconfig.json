{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@fixtures/*": [
        "./fixtures/*"
      ],
      "@pages/*": [
        "./pages/*"
      ],
      "@tests/*": [
        "./tests/*"
      ]
    },
    "types": [
      "node",
      "@playwright/test"
    ],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "playwright.config.ts",
    "fixtures/**/*",
    "page-objects/**/*",
    "tests/**/*"
  ]
}